---
import Layout from "../layouts/Layout.astro";
import ThemeSwitcher from "../components/ThemeSwitcher.astro";

const currentYear = new Date().getFullYear();
---

<Layout
  title="404 - page not found"
  description="The page you're looking for doesn't exist. Navigate back to the homepage or explore the blog."
>
  <div class="container">
    <nav class="nav">
      <a href="/">home</a>
      <a href="/blog">blog</a>
      <a href="/contact">contact</a>
      <ThemeSwitcher />
    </nav>

    <main class="main">
      <div class="error-content">
        <div class="glitch-wrapper">
          <h1 class="glitch" data-text="404">404</h1>
        </div>

        <pre
          class="ascii-art">
  ╔═══════════════════════════════╗
  ║   PAGE NOT FOUND              ║
  ║                               ║
  ║   > ls -la /page              ║
  ║   ls: cannot access '/page'   ║
  ║   No such file or directory   ║
  ╚═══════════════════════════════╝</pre>

        <p class="message">
          the page you're looking for has vanished into the void.
        </p>

        <div class="actions">
          <a href="/" class="btn-primary">take me home</a>
          <a href="/blog" class="btn-secondary">read the blog</a>
        </div>

        <div class="noise"></div>
      </div>
    </main>

    <footer class="footer">
      <p>
        <a
          href="https://github.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">github</a
        > • <a
          href="https://x.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">twitter</a
        > • <a href="/rss.xml">rss</a> • © {currentYear}
      </p>
    </footer>
  </div>

  <script>
    // Glitch effect on hover
    const glitchElement = document.querySelector(".glitch");
    let isGlitching = false;

    function triggerGlitch() {
      if (isGlitching) return;
      isGlitching = true;
      glitchElement?.classList.add("active");

      setTimeout(() => {
        glitchElement?.classList.remove("active");
        isGlitching = false;
      }, 400);
    }

    // Random glitch every 5-8 seconds
    function randomGlitch() {
      const delay = 5000 + Math.random() * 3000;
      setTimeout(() => {
        triggerGlitch();
        randomGlitch();
      }, delay);
    }

    glitchElement?.addEventListener("mouseenter", triggerGlitch);
    randomGlitch();

    // Floating animation for noise
    const noise = document.querySelector(".noise") as HTMLElement;
    let position = 0;

    function animateNoise() {
      position += 0.5;
      if (noise) {
        noise.style.backgroundPosition = `${position}px ${position}px`;
      }
      requestAnimationFrame(animateNoise);
    }

    animateNoise();
  </script>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  .nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-bottom: 3rem;
    font-size: 1rem;
    z-index: 10;
  }

  .nav a:first-child {
    margin-right: auto;
  }

  .nav a {
    color: var(--fg);
    font-weight: 500;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .main {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .error-content {
    text-align: center;
    position: relative;
    z-index: 2;
    animation: fadeInUp 0.8s ease-out;
  }

  /* Glitch Effect */
  .glitch-wrapper {
    position: relative;
    margin-bottom: 2rem;
  }

  .glitch {
    font-size: clamp(6rem, 15vw, 12rem);
    font-weight: 700;
    color: var(--fg);
    margin: 0;
    position: relative;
    letter-spacing: 0.05em;
    font-family: "JetBrains Mono", monospace;
    user-select: none;
    cursor: pointer;
  }

  .glitch::before,
  .glitch::after {
    content: attr(data-text);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }

  .glitch.active::before {
    left: 2px;
    text-shadow: -2px 0 var(--accent);
    color: var(--accent);
    animation: glitch-anim-1 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  .glitch.active::after {
    left: -2px;
    text-shadow: 2px 0 #00ffff;
    color: #00ffff;
    animation: glitch-anim-2 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  }

  @keyframes glitch-anim-1 {
    0% {
      opacity: 1;
      transform: translate(0);
    }
    20% {
      opacity: 1;
      transform: translate(-2px, 2px);
    }
    40% {
      opacity: 1;
      transform: translate(-2px, -2px);
    }
    60% {
      opacity: 1;
      transform: translate(2px, 2px);
    }
    80% {
      opacity: 1;
      transform: translate(2px, -2px);
    }
    100% {
      opacity: 0;
      transform: translate(0);
    }
  }

  @keyframes glitch-anim-2 {
    0% {
      opacity: 1;
      transform: translate(0);
    }
    20% {
      opacity: 1;
      transform: translate(2px, -2px);
    }
    40% {
      opacity: 1;
      transform: translate(2px, 2px);
    }
    60% {
      opacity: 1;
      transform: translate(-2px, -2px);
    }
    80% {
      opacity: 1;
      transform: translate(-2px, 2px);
    }
    100% {
      opacity: 0;
      transform: translate(0);
    }
  }

  /* ASCII Art */
  .ascii-art {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.75rem;
    line-height: 1.4;
    color: var(--fg-muted);
    margin: 2rem auto;
    padding: 1.5rem;
    border: 1px solid var(--border);
    background: rgba(139, 92, 246, 0.03);
    max-width: fit-content;
    position: relative;
    overflow: hidden;
  }

  .ascii-art::before {
    content: "";
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(139, 92, 246, 0.1),
      transparent
    );
    animation: scan 3s ease-in-out infinite;
  }

  @keyframes scan {
    0%,
    100% {
      left: -100%;
    }
    50% {
      left: 100%;
    }
  }

  .message {
    color: var(--fg-muted);
    font-size: 1.125rem;
    margin: 2rem 0;
    max-width: 500px;
    margin-left: auto;
    margin-right: auto;
  }

  /* Action Buttons */
  .actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .btn-primary,
  .btn-secondary {
    padding: 0.875rem 2rem;
    font-size: 0.9375rem;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--bg);
    border: 1px solid var(--accent);
  }

  .btn-primary::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 50%;
    width: 0;
    height: 0;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 50%;
    transform: translate(-50%, -50%);
    transition:
      width 0.6s,
      height 0.6s;
  }

  .btn-primary:hover::before {
    width: 300px;
    height: 300px;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(139, 92, 246, 0.3);
  }

  .btn-secondary {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
  }

  .btn-secondary:hover {
    background: rgba(139, 92, 246, 0.1);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  /* Animated Noise Background */
  .noise {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    opacity: 0.015;
    z-index: 1;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 400 400' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
    background-repeat: repeat;
  }

  .footer {
    margin-top: 6rem;
    padding-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
    text-align: center;
    z-index: 10;
  }

  .footer a {
    color: var(--fg-muted);
  }

  .footer a:hover {
    color: var(--accent);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 640px) {
    .container {
      padding: 2rem 1.5rem;
    }

    .nav {
      gap: 0.75rem 1rem;
    }

    .glitch {
      font-size: clamp(4rem, 20vw, 6rem);
    }

    .ascii-art {
      font-size: 0.5rem;
      padding: 1rem;
    }

    .message {
      font-size: 1rem;
    }

    .actions {
      flex-direction: column;
      align-items: stretch;
    }

    .btn-primary,
    .btn-secondary {
      width: 100%;
      text-align: center;
    }
  }
</style>
