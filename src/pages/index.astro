---
import Layout from "../layouts/Layout.astro";

const currentYear = new Date().getFullYear();
---

<Layout title="4bs3nt" description="software engineer and security researcher.">
  <div class="container">
    <nav class="nav">
      <a href="/">home</a>
      <a href="/blog">blog</a>
      <a href="/contact">contact</a>
    </nav>

    <header class="header">
      <pre
        class="ascii-art">    :::     :::::::::   ::::::::   ::::::::  ::::    ::: :::::::::::
   :+:      :+:    :+: :+:    :+: :+:    :+: :+:+:   :+:     :+:
  +:+ +:+   +:+    +:+ +:+               +:+ :+:+:+  +:+     +:+
 +#+  +:+   +#++:++#+  +#++:++#++     +#++:  +#+ +:+ +#+     +#+
+#+#+#+#+#+ +#+    +#+        +#+        +#+ +#+  +#+#+#     +#+
      #+#   #+#    #+# #+#    #+# #+#    #+# #+#   #+#+#     #+#
      ###   #########   ########   ########  ###    ####     ###</pre>
    </header>

    <main class="main">
      <section class="about">
        <h2>me</h2>
        <p>hello, i'm jan. welcome.</p>
        <p>
          i'm a software engineer and security researcher. i keep most of my
          work open source.
        </p>
        <p>
          some contractual work and research has to remain private. sorry about
          that.
        </p>
        <br />
        <p>
          i am open to work, consulting and collaboration. feel free to reach
          out via <a href="/contact">contact page</a>.
        </p>
      </section>
    </main>

    <footer class="footer">
      <p>
        <a
          href="https://github.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">github</a
        > • <a
          href="https://x.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">twitter</a
        > • <a href="/rss.xml">rss</a> • © {currentYear}
      </p>
    </footer>
  </div>
</Layout>

<style>
  .container {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .nav {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 5rem;
    font-size: 1rem;
  }

  .nav a:first-child {
    margin-right: auto;
  }

  .nav a {
    color: var(--fg);
    font-weight: 500;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .header {
    margin-bottom: 5rem;
  }

  .ascii-art {
    font-size: 0.65rem;
    line-height: 1.2;
    color: var(--fg);
    white-space: pre;
    font-family: "JetBrains Mono", monospace;
    display: block;
    margin: 0 auto;
    width: fit-content;
    letter-spacing: 0.2em;
    transform-origin: center;
    transition: transform 0.3s ease;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    flex: 1;
  }

  section h2 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--fg);
  }

  section p {
    color: var(--fg-muted);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.1rem;
  }

  .intro p:first-child {
    color: var(--accent);
    font-weight: 500;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .footer {
    margin-top: 6rem;
    padding-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer a {
    color: var(--fg-muted);
  }

  .footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .container {
      padding: 2rem 1.5rem;
    }

    .nav {
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }

    .ascii-art {
      font-size: 0.4rem;
      letter-spacing: 0.08em;
      transform: scale(1);
    }
  }

  @media (max-width: 480px) {
    .ascii-art {
      font-size: 0.32rem;
      letter-spacing: 0.05em;
    }
  }

  @media (max-width: 360px) {
    .ascii-art {
      font-size: 0.28rem;
      letter-spacing: 0.02em;
    }
  }
</style>
