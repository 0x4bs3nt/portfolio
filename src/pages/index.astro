---
import Layout from "../layouts/Layout.astro";
---

<Layout>
  <div class="container">
    <nav class="nav">
      <a href="/">home</a>
      <a href="/blog">blog</a>
      <a href="/contact">contact</a>
    </nav>

    <header class="header">
      <h1>Portfolio</h1>
    </header>

    <main class="main">
      <section class="intro">
        <p>developer / designer / builder</p>
        <p class="subtitle">
          building things that matter. writing code, creating experiences.
        </p>
      </section>

      <section class="about">
        <h2>about</h2>
        <p>
          i build elegant solutions to complex problems. focused on clean code,
          intuitive design, and creating experiences that work.
        </p>
        <p>
          when not coding: exploring new tech, contributing to open source,
          sharing thoughts on the blog.
        </p>
      </section>

      <section class="links">
        <h2>links</h2>
        <ul>
          <li><a href="/blog">blog</a> - technical writing and thoughts</li>
          <li><a href="/contact">contact</a> - get in touch</li>
          <li><a href="/rss.xml">rss</a> - subscribe to updates</li>
        </ul>
      </section>
    </main>

    <footer class="footer">
      <p>© 2025</p>
    </footer>
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .nav {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
    font-size: 1rem;
  }

  .nav a {
    color: var(--fg);
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .header {
    margin-bottom: 3rem;
  }

  .header h1 {
    font-size: 2rem;
    font-weight: 600;
  }

  .main {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  section h2 {
    font-size: 1rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--fg);
  }

  section p {
    color: var(--fg-muted);
    margin-bottom: 1rem;
  }

  .intro {
    font-size: 1.1rem;
  }

  .intro p:first-child {
    color: var(--accent);
    font-weight: 500;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .links ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .links li {
    color: var(--fg-muted);
  }

  .links a {
    color: var(--accent);
  }

  .footer {
    margin-top: 6rem;
    padding-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .container {
      padding: 2rem 1.5rem;
    }

    .nav {
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }

  }
</style>
