---
import Layout from "../layouts/Layout.astro";

const currentYear = new Date().getFullYear();
---

<Layout title="contact">
  <div class="container">
    <nav class="nav">
      <a href="/">home</a>
      <a href="/blog">blog</a>
      <a href="/contact">contact</a>
    </nav>

    <header class="header">
      <h1>contact</h1>
      <p class="subtitle">get in touch</p>
    </header>

    <main class="main">
      <div class="contact-list">
        <div class="contact-item">
          <span class="contact-label">github:</span>
          <a
            href="https://github.com/0x4bs3nt"
            target="_blank"
            rel="noopener noreferrer">@0x4bs3nt</a
          >
        </div>
        <div class="contact-item">
          <span class="contact-label">twitter:</span>
          <a
            href="https://x.com/0x4bs3nt"
            target="_blank"
            rel="noopener noreferrer">@0x4bs3nt</a
          >
        </div>
        <div class="contact-item">
          <span class="contact-label">email:</span>
          <a href="mailto:hi@4bs3nt.com">hi@4bs3nt.com</a>
        </div>
        <div class="contact-item">
          <span class="contact-label">signal:</span>
          <span class="contact-value">x4bs3nt.12</span>
        </div>
      </div>

      <p class="note">discord available upon request</p>
    </main>

    <footer class="footer">
      <p>
        <a
          href="https://github.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">github</a
        > • <a
          href="https://x.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">twitter</a
        > • <a href="/rss.xml">rss</a> • © {currentYear}
      </p>
    </footer>
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .nav {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
    font-size: 1rem;
  }

  .nav a:first-child {
    margin-right: auto;
  }

  .nav a {
    color: var(--fg);
    font-weight: 500;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .header {
    margin-bottom: 3rem;
  }

  .header h1 {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .main {
    flex: 1;
  }

  .contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .contact-item {
    display: flex;
    gap: 1rem;
    align-items: baseline;
  }

  .contact-label {
    color: var(--fg-muted);
    min-width: 80px;
  }

  .contact-item a {
    color: var(--accent);
  }

  .contact-item a:hover {
    text-decoration: underline;
  }

  .contact-value {
    color: var(--fg);
  }

  .note {
    margin-top: 2rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .footer {
    margin-top: 6rem;
    padding-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer a {
    color: var(--fg-muted);
  }

  .footer a:hover {
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .container {
      padding: 2rem 1.5rem;
    }

    .nav {
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }

    .contact-item {
      flex-direction: column;
      gap: 0.25rem;
    }

    .contact-label {
      min-width: auto;
    }
  }
</style>
