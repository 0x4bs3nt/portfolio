---
import { getCollection } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import BlogSearch from "../../components/BlogSearch";
import "../../components/BlogSearch.css";
import { getAllTags, formatDate } from "../../utils/blog";

const allPosts = await getCollection("blog");
const posts = allPosts
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = getAllTags(posts);
---

<Layout title="blog">
  <div class="container">
    <nav class="nav">
      <a href="/">home</a>
      <a href="/blog">blog</a>
      <a href="/contact">contact</a>
    </nav>

    <header class="header">
      <h1>blog</h1>
      <p class="subtitle">technical writing, thoughts, and explorations</p>
    </header>

    {allTags.length > 0 && (
      <div class="tags">
        <span class="tags-label">tags:</span>
        {allTags.map((tag) => (
          <a href={`/blog/tags/${tag}`} class="tag">{tag}</a>
        ))}
      </div>
    )}

    <BlogSearch client:load posts={posts} />

    <footer class="footer">
      <p>© 2025</p>
    </footer>
  </div>
</Layout>

<style>
  .container {
    max-width: 800px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .nav {
    display: flex;
    gap: 1.5rem;
    margin-bottom: 3rem;
    font-size: 1rem;
  }

  .nav a {
    color: var(--fg);
  }

  .nav a:hover {
    text-decoration: underline;
  }

  .header {
    margin-bottom: 2rem;
  }

  .header h1 {
    font-size: 1.5rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: var(--fg-muted);
    font-size: 0.95rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
  }

  .tags-label {
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  .tag {
    color: var(--accent);
    font-size: 0.9rem;
  }

  .footer {
    margin-top: 6rem;
    padding-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
  }

  @media (max-width: 640px) {
    .container {
      padding: 2rem 1.5rem;
    }

    .nav {
      flex-direction: column;
      gap: 0.75rem;
      margin-bottom: 3rem;
    }
  }
</style>
