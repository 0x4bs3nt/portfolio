---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import BlogSearch from '../../components/BlogSearch';
import '../../components/BlogSearch.css';
import { getAllTags } from '../../utils/blog';

// Get all blog posts and sort by date (newest first)
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const allTags = getAllTags(posts);
---

<Layout
  title="Blog"
  description="Thoughts, tutorials, and musings on web development."
>
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">Portfolio</a>
      <div class="nav-links">
        <a href="/blog" class="active">Blog</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>

    <main class="main">
      <header class="page-header">
        <h1>Blog</h1>
        <p>Thoughts, tutorials, and musings on web development.</p>
      </header>

      {allTags.length > 0 && (
        <div class="tags-filter">
          <span class="filter-label">Filter by tag:</span>
          <div class="tags">
            {allTags.map(tag => (
              <a href={`/blog/tags/${tag}`} class="tag-link">{tag}</a>
            ))}
          </div>
        </div>
      )}

      <BlogSearch client:load posts={posts} />
    </main>
  </div>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: 100vh;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 3rem;
    margin-bottom: 4rem;
    border-bottom: 1px solid var(--color-border);
    animation: fadeInDown 0.6s var(--ease-smooth);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.3s var(--ease-smooth);
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    position: relative;
    transition: color 0.3s var(--ease-smooth);
  }

  .nav-links a.active {
    color: var(--color-text);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.3s var(--ease-smooth);
  }

  .nav-links a.active::after {
    width: 100%;
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  /* Page Header */
  .page-header {
    margin-bottom: 2rem;
    animation: fadeInUp 0.7s var(--ease-smooth) 0.1s backwards;
  }

  .page-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.5rem);
    font-weight: 500;
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
  }

  .page-header p {
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  /* Tags Filter */
  .tags-filter {
    margin-bottom: 2rem;
    animation: fadeInUp 0.7s var(--ease-smooth) 0.12s backwards;
  }

  .filter-label {
    display: block;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
    font-weight: 500;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-link {
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: rgba(12, 74, 110, 0.08);
    padding: 0.375rem 0.875rem;
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s var(--ease-smooth);
  }

  .tag-link:hover {
    background: var(--color-accent);
    color: white;
    transform: translateY(-1px);
  }

  /* Animations */
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .container {
      padding: 1.5rem 1rem;
    }

    .nav {
      padding-bottom: 2rem;
      margin-bottom: 3rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    .page-header {
      margin-bottom: 2rem;
    }

    .posts {
      gap: 2rem;
    }

    .post-link {
      padding: 1.5rem;
    }

    .post-title {
      font-size: 1.25rem;
    }
  }
</style>
