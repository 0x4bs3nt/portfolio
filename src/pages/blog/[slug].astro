---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Layout from "../../layouts/Layout.astro";
import ThemeSwitcher from "../../components/ThemeSwitcher.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import {
  formatDate,
  getReadingTime,
  getTableOfContents,
} from "../../utils/blog";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await post.render();

// Get raw content for reading time and TOC
const rawContent = post.body;
const readingTime = getReadingTime(rawContent);
const tableOfContents = getTableOfContents(rawContent);
const currentYear = new Date().getFullYear();
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
>
  <div class="container">
    <nav class="nav">
      <a href="/">home</a>
      <a href="/blog">blog</a>
      <a href="/contact">contact</a>
      <ThemeSwitcher />
    </nav>

    <main class="main">
      <a href="/blog" class="back-link">← back</a>

      <article class="post">
        <header class="post-header">
          <div class="post-meta">
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <span class="separator">·</span>
            <span class="reading-time">{readingTime}</span>
          </div>
          <h1 class="post-title">{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="post-tags">
                {post.data.tags.map((tag) => (
                  <a href={`/blog?tag=${tag}`} class="tag">
                    {tag}
                  </a>
                ))}
              </div>
            )
          }
        </header>

        <div class="post-body">
          <aside class="post-sidebar">
            <TableOfContents headings={tableOfContents} />
          </aside>

          <div class="post-content">
            <Content />
          </div>
        </div>
      </article>

      <footer class="post-footer">
        <a href="/blog" class="back-link">← back to all posts</a>
      </footer>
    </main>

    <footer class="footer">
      <p>
        <a
          href="https://github.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">github</a
        > • <a
          href="https://x.com/0x4bs3nt"
          target="_blank"
          rel="noopener noreferrer">twitter</a
        > • <a href="/rss.xml">rss</a> • © {currentYear}
      </p>
    </footer>
  </div>

  <button id="scroll-to-top" class="scroll-to-top" aria-label="Scroll to top">
    <svg
      width="24"
      height="24"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="M12 19V5M5 12l7-7 7 7"></path>
    </svg>
  </button>

  <script>
    let scrollHandler: (() => void) | null = null;
    let clickHandler: (() => void) | null = null;

    function initScrollToTop() {
      const scrollToTopBtn = document.getElementById("scroll-to-top");

      if (!scrollToTopBtn) return;

      // Remove existing listeners if any
      if (scrollHandler) {
        window.removeEventListener("scroll", scrollHandler);
      }
      if (clickHandler) {
        scrollToTopBtn.removeEventListener("click", clickHandler);
      }

      // Create new scroll handler
      scrollHandler = () => {
        if (window.scrollY > 300) {
          scrollToTopBtn.classList.add("visible");
        } else {
          scrollToTopBtn.classList.remove("visible");
        }
      };

      // Create new click handler
      clickHandler = () => {
        window.scrollTo({
          top: 0,
          behavior: "smooth",
        });
      };

      // Add event listeners
      window.addEventListener("scroll", scrollHandler, { passive: true });
      scrollToTopBtn.addEventListener("click", clickHandler);

      // Initial check for scroll position
      scrollHandler();
    }

    // Run on initial page load
    document.addEventListener("DOMContentLoaded", initScrollToTop);

    // Run after view transitions (desktop only)
    document.addEventListener("astro:page-load", initScrollToTop);
  </script>
</Layout>

<style>
  html {
    scroll-behavior: smooth;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  /* Navigation */
  .nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    margin-bottom: 4rem;
    font-size: 1rem;
  }

  .main {
    flex: 1;
  }

  .nav a:first-child {
    margin-right: auto;
  }

  .nav a {
    color: var(--fg);
    font-weight: 500;
    text-decoration: none;
  }

  .nav a:hover {
    text-decoration: underline;
  }

  /* Back Link */
  .back-link {
    display: inline-block;
    color: var(--fg-muted);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 1.5rem;
    text-transform: lowercase;
    letter-spacing: 0.02em;
  }

  .back-link:hover {
    color: var(--accent);
  }

  /* Post Header - Full Width */
  .post-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--fg-muted);
    margin-bottom: 1.5rem;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .post-date {
    color: var(--fg-muted);
  }

  .separator {
    color: var(--border);
  }

  .reading-time {
    color: var(--fg-muted);
  }

  .post-title {
    font-size: clamp(2.25rem, 6vw, 3.5rem);
    font-weight: 600;
    line-height: 1.15;
    margin-bottom: 1.5rem;
    letter-spacing: -0.03em;
    color: var(--fg);
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--fg-muted);
    line-height: 1.7;
    margin-bottom: 1.5rem;
    max-width: 42rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .tag {
    font-size: 0.75rem;
    color: var(--accent);
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 600;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    transition: all 0.2s;
  }

  .tag:hover {
    border-color: var(--accent);
    background: var(--accent);
    color: var(--bg);
  }

  /* Two-Column Layout */
  .post-body {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 6rem;
    align-items: start;
  }

  .post-sidebar {
    position: sticky;
    top: 2rem;
    align-self: start;
  }

  /* Post Content - Refined Typography */
  .post-content {
    min-width: 0;
    max-width: 770px;
    margin-left: 2rem;
  }

  .post-content :global(*:first-child) {
    margin-top: 0;
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-weight: 600;
    line-height: 1.3;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
    color: var(--fg);
    scroll-margin-top: 2rem;
  }

  .post-content :global(h1) {
    font-size: 2.25rem;
    margin-top: 4rem;
  }

  .post-content :global(h2) {
    font-size: 1.875rem;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(h4) {
    font-size: 1.25rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.75rem;
    color: var(--fg-muted);
    font-size: 1rem;
    line-height: 1.8;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s;
  }

  .post-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.75rem;
    padding-left: 2rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.75rem;
    color: var(--fg-muted);
    line-height: 1.7;
  }

  .post-content :global(li::marker) {
    color: var(--accent);
  }

  .post-content :global(strong) {
    color: var(--fg);
    font-weight: 600;
  }

  .post-content :global(em) {
    font-style: italic;
    color: var(--fg);
  }

  .post-content :global(code) {
    font-family: "JetBrains Mono", monospace;
    font-size: 0.9em;
    background: var(--code-bg);
    padding: 0.25em 0.5em;
    color: var(--accent);
    border: 1px solid var(--border);
  }

  .post-content :global(pre) {
    background: var(--surface);
    padding: 1rem;
    overflow-x: auto;
    margin: 2rem 0;
    border: 1px solid var(--border);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.9rem;
    line-height: 1.7;
    color: var(--fg);
    border: none;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1.5rem;
    margin: 2.5rem 0;
    font-style: italic;
    color: var(--fg);
    font-size: 1.0625rem;
  }

  .post-content :global(blockquote p) {
    color: var(--fg);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 3.5rem 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    margin: 2.5rem 0;
    border: 1px solid var(--border);
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.9375rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--surface);
    font-weight: 600;
    color: var(--fg);
  }

  .post-content :global(td) {
    color: var(--fg-muted);
  }

  /* Post Footer */
  .post-footer {
    margin-top: 5rem;
    padding-top: 3rem;
    border-top: 1px solid var(--border);
  }

  .post-footer .back-link {
    margin-bottom: 0;
  }

  /* Page Footer */
  .footer {
    margin-top: 6rem;
    padding-top: 3rem;
    color: var(--fg-muted);
    font-size: 0.85rem;
    text-align: center;
  }

  .footer a {
    color: var(--fg-muted);
  }

  .footer a:hover {
    color: var(--accent);
  }

  /* Scroll to Top Button */
  .scroll-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 2.5rem;
    height: 2.5rem;
    background: transparent;
    color: var(--accent);
    border: 1px solid var(--accent);
    border-radius: 0;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s,
      visibility 0.3s,
      transform 0.2s,
      background 0.2s;
    z-index: 1000;
  }

  .scroll-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .scroll-to-top:hover {
    transform: translateY(-3px);
    background: var(--accent);
    color: var(--bg);
  }

  .scroll-to-top:active {
    transform: translateY(-1px);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .post-body {
      gap: 3rem;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 2rem 1rem;
    }

    .nav {
      gap: 0.75rem 1rem;
      margin-bottom: 3rem;
    }

    .post-header {
      margin-bottom: 3rem;
      padding-bottom: 2rem;
    }

    .post-body {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }

    .post-sidebar {
      position: static;
      order: -1;
    }

    .post-content {
      max-width: 100%;
      margin-left: 0;
    }

    .post-content :global(h1) {
      font-size: 1.875rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }

    .post-content :global(h3) {
      font-size: 1.25rem;
    }

    .post-footer {
      margin-top: 3rem;
    }
  }
</style>
