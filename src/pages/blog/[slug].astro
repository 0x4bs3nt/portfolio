---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { formatDate, getReadingTime, getTableOfContents } from '../../utils/blog';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map(post => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { Content } = await post.render();

// Get raw content for reading time and TOC
const rawContent = post.body;
const readingTime = getReadingTime(rawContent);
const tableOfContents = getTableOfContents(rawContent);
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.date}
  tags={post.data.tags}
>
  <div class="container">
    <nav class="nav">
      <a href="/" class="logo">Portfolio</a>
      <div class="nav-links">
        <a href="/blog">Blog</a>
        <a href="/contact">Contact</a>
      </div>
    </nav>

    <main class="main">
      <a href="/blog" class="back-link">← Back to all posts</a>

      <article class="post">
        <header class="post-header">
          <div class="post-meta">
            <time class="post-date" datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
            <span class="separator">·</span>
            <span class="reading-time">{readingTime}</span>
          </div>
          <h1 class="post-title">{post.data.title}</h1>
          <p class="post-description">{post.data.description}</p>
          {post.data.tags && post.data.tags.length > 0 && (
            <div class="post-tags">
              {post.data.tags.map(tag => (
                <a href={`/blog/tags/${tag}`} class="tag">{tag}</a>
              ))}
            </div>
          )}
        </header>

        <TableOfContents headings={tableOfContents} />

        <div class="post-content">
          <Content />
        </div>
      </article>

      <footer class="post-footer">
        <a href="/blog" class="back-link">← Back to all posts</a>
      </footer>
    </main>
  </div>
</Layout>

<style>
  .container {
    max-width: 720px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
    min-height: 100vh;
  }

  /* Navigation */
  .nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 3rem;
    margin-bottom: 3rem;
    border-bottom: 1px solid var(--color-border);
    animation: fadeInDown 0.6s var(--ease-smooth);
  }

  .logo {
    font-family: var(--font-serif);
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--color-text);
    text-decoration: none;
    letter-spacing: -0.01em;
    transition: color 0.3s var(--ease-smooth);
  }

  .logo:hover {
    color: var(--color-accent);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    font-weight: 500;
    position: relative;
    transition: color 0.3s var(--ease-smooth);
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 0;
    height: 1px;
    background: var(--color-accent);
    transition: width 0.3s var(--ease-smooth);
  }

  .nav-links a:hover {
    color: var(--color-text);
  }

  .nav-links a:hover::after {
    width: 100%;
  }

  /* Back Link */
  .back-link {
    display: inline-block;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9375rem;
    margin-bottom: 2rem;
    transition: all 0.3s var(--ease-smooth);
    animation: fadeIn 0.7s var(--ease-smooth) 0.1s backwards;
  }

  .back-link:hover {
    color: var(--color-accent);
    transform: translateX(-4px);
  }

  /* Post */
  .post {
    animation: fadeInUp 0.7s var(--ease-smooth) 0.15s backwards;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .post-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-text-muted);
    margin-bottom: 1rem;
  }

  .post-date {
    color: var(--color-text-muted);
  }

  .separator {
    color: var(--color-text-muted);
  }

  .reading-time {
    color: var(--color-text-muted);
  }

  .post-title {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 5vw, 2.75rem);
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .post-description {
    font-size: 1.125rem;
    color: var(--color-text-muted);
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.8125rem;
    color: var(--color-accent);
    background: rgba(12, 74, 110, 0.08);
    padding: 0.25rem 0.75rem;
    border-radius: 4px;
    font-weight: 500;
    text-decoration: none;
    transition: all 0.3s var(--ease-smooth);
  }

  .tag:hover {
    background: var(--color-accent);
    color: white;
  }

  /* Post Content - Markdown Styles */
  .post-content {
    line-height: 1.8;
    color: var(--color-text);
  }

  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4),
  .post-content :global(h5),
  .post-content :global(h6) {
    font-family: var(--font-serif);
    font-weight: 500;
    line-height: 1.3;
    margin-top: 2.5rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .post-content :global(h1) {
    font-size: 2rem;
    margin-top: 3rem;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
  }

  .post-content :global(h3) {
    font-size: 1.5rem;
  }

  .post-content :global(h4) {
    font-size: 1.25rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
  }

  .post-content :global(a) {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid rgba(12, 74, 110, 0.3);
    transition: border-color 0.3s var(--ease-smooth);
  }

  .post-content :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-text-muted);
  }

  .post-content :global(li::marker) {
    color: var(--color-accent);
  }

  .post-content :global(code) {
    font-family: 'Consolas', 'Monaco', 'Courier New', monospace;
    font-size: 0.9em;
    background: rgba(28, 25, 23, 0.05);
    padding: 0.2em 0.4em;
    border-radius: 3px;
    color: var(--color-text);
  }

  .post-content :global(pre) {
    background: rgba(28, 25, 23, 0.05);
    padding: 1.25rem;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 1.5rem;
    border: 1px solid var(--color-border);
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    padding-left: 1.25rem;
    margin: 2rem 0;
    font-style: italic;
    color: var(--color-text-muted);
  }

  .post-content :global(hr) {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  .post-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 2rem 0;
  }

  /* Post Footer */
  .post-footer {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
    animation: fadeIn 0.7s var(--ease-smooth) 0.3s backwards;
  }

  /* Animations */
  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  /* Responsive */
  @media (max-width: 640px) {
    .container {
      padding: 1.5rem 1rem;
    }

    .nav {
      padding-bottom: 2rem;
      margin-bottom: 2rem;
    }

    .nav-links {
      gap: 1.5rem;
    }

    .post-header {
      margin-bottom: 2rem;
      padding-bottom: 1.5rem;
    }

    .post-content :global(h1) {
      font-size: 1.75rem;
    }

    .post-content :global(h2) {
      font-size: 1.5rem;
    }

    .post-content :global(h3) {
      font-size: 1.25rem;
    }

    .post-footer {
      margin-top: 3rem;
    }
  }
</style>
