---
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: "website" | "article";
  publishedTime?: Date;
  tags?: string[];
}

const {
  title = "4bs3nt",
  description = "software engineer, security researcher",
  image = "/og-image.png",
  type = "website",
  publishedTime,
  tags = [],
} = Astro.props;

const siteUrl = Astro.site?.href || `http://localhost:4321`;
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
const socialImage = new URL(image, siteUrl);
const fullTitle = title === "4bs3nt" ? title : `${title} | 4bs3nt`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#000000" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="title" content={fullTitle} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImage} />
    {
      publishedTime && (
        <meta
          property="article:published_time"
          content={publishedTime.toISOString()}
        />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={fullTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImage} />

    <link
      rel="alternate"
      type="application/rss+xml"
      title="Blog RSS Feed"
      href="/rss.xml"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Rubik:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <ClientRouter />
    <script is:inline>
      (function () {
        var ORDER = ["system", "light", "dark"];
        function applyTheme() {
          var stored = localStorage.getItem("theme") || "system";
          var effective;
          if (stored === "system") {
            effective = window.matchMedia("(prefers-color-scheme: light)")
              .matches
              ? "light"
              : "dark";
          } else {
            effective = stored;
          }
          document.documentElement.setAttribute("data-theme", effective);
          document.documentElement.setAttribute(
            "data-theme-preference",
            stored,
          );
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta)
            meta.setAttribute(
              "content",
              effective === "light" ? "#ffffff" : "#000000",
            );
          var idx = ORDER.indexOf(stored);
          if (idx < 0) idx = 0;
          var tracks = document.querySelectorAll(".theme-track");
          for (var i = 0; i < tracks.length; i++) {
            tracks[i].classList.add("no-transition");
            tracks[i].setAttribute("data-active-index", String(idx));
          }
          var buttons = document.querySelectorAll("[data-theme-option]");
          for (var j = 0; j < buttons.length; j++) {
            if (buttons[j].getAttribute("data-theme-option") === stored) {
              buttons[j].classList.add("active");
            } else {
              buttons[j].classList.remove("active");
            }
          }
          if (tracks.length) {
            requestAnimationFrame(function () {
              for (var i = 0; i < tracks.length; i++) {
                tracks[i].classList.remove("no-transition");
              }
            });
          }
        }
        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        window
          .matchMedia("(prefers-color-scheme: light)")
          .addEventListener("change", function () {
            if (
              !localStorage.getItem("theme") ||
              localStorage.getItem("theme") === "system"
            ) {
              applyTheme();
            }
          });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --bg: #000000;
    --fg: #e5e7eb;
    --fg-muted: #9ca3af;
    --accent: #8b5cf6;
    --border: #374151;
    --code-bg: rgba(255, 255, 255, 0.05);
    --surface: rgba(255, 255, 255, 0.03);
    color-scheme: dark;
  }

  html[data-theme="light"] {
    --bg: #ffffff;
    --fg: #1e1b2e;
    --fg-muted: #6b6584;
    --accent: #7c3aed;
    --border: #9c92b4;
    --code-bg: rgba(124, 58, 237, 0.07);
    --surface: rgba(124, 58, 237, 0.04);
    color-scheme: light;
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  html {
    background: var(--bg);
    color: var(--fg);
    font-family: "Rubik", sans-serif;
    font-size: 15px;
    line-height: 1.6;
    scrollbar-gutter: stable;
    overscroll-behavior-y: none;
  }

  code,
  pre {
    font-family: "JetBrains Mono", monospace;
  }

  body {
    min-height: 100vh;
    overscroll-behavior-y: none;
  }

  ::selection {
    background: var(--accent);
    color: var(--bg);
  }

  a {
    color: var(--accent);
    text-decoration: none;
    transition: opacity 0.2s;
  }

  a:hover {
    opacity: 0.8;
  }

  .astro-code,
  .astro-code span {
    color: var(--shiki-dark) !important;
    background-color: var(--shiki-dark-bg) !important;
    font-style: var(--shiki-dark-font-style) !important;
    font-weight: var(--shiki-dark-font-weight) !important;
  }

  html[data-theme="light"] .astro-code {
    color: var(--shiki-light) !important;
    background-color: #f7f7f9 !important;
    font-style: var(--shiki-light-font-style) !important;
    font-weight: var(--shiki-light-font-weight) !important;
  }

  html[data-theme="light"] .astro-code span {
    color: var(--shiki-light) !important;
    background-color: transparent !important;
    font-style: var(--shiki-light-font-style) !important;
    font-weight: var(--shiki-light-font-weight) !important;
  }

  html.theme-switching::view-transition-old(root) {
    animation: none;
    z-index: -1;
  }

  html.theme-switching::view-transition-new(root) {
    animation: none;
    mix-blend-mode: normal;
  }
</style>
